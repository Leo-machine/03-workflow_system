# 后端本地开发配置；cp .env.example .env 后按需修改；.env 不提交 git
# ⚠️ 迁内网前务必改掉默认密码与 JWT_SECRET
# 端口与仓库根目录 .env / docker-compose 默认对齐，避免与本机其他系统冲突

DATABASE_URL=postgresql+psycopg://flow:flow@localhost:5433/flowmap
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

CORS_ORIGINS=http://localhost:5174,http://localhost:8081
UPLOAD_DIR=data/uploads
