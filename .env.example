# ===== 根配置（docker-compose 读取本文件）=====
# 用法：cp .env.example .env 后按需修改；.env 不提交 git
# ⚠️ 迁内网前务必改掉所有默认密码与 JWT_SECRET

POSTGRES_USER=flow
POSTGRES_PASSWORD=flow
POSTGRES_DB=flowmap

# 后端 JWT 签名密钥（务必替换为随机长串）
JWT_SECRET=change-me-to-a-long-random-string

# 初始账号（仅首次 seed 时生效，改密码请直接改库或后续做账号管理）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# ----- 宿主机端口（可改，避免与本机其他系统冲突）-----
# 容器内部端口不变：postgres=5432 / backend=8000 / frontend=80
POSTGRES_PORT=5433
BACKEND_PORT=8001
WEB_PORT=8081
# 本地前端 npm run dev 时的端口（写入 CORS 白名单）
VITE_DEV_PORT=5174
